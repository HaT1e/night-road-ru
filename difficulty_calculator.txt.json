{
  "crc": -314626335,
  "lines": [
    "*comment Difficulty Calculator Miniscene",
    "",
    "*set claws_out false",
    "*set fangs_out false",
    "*set beast_form false",
    "",
    "*set talked_to_elena false",
    "*comment Every time you finish a mission you can talk to Елена again.",
    "",
    "*set ghoul_activity_available true",
    "*comment Every time you finish a mission you can engage in another ghoul activity, if you have a ghoul",
    "",
    "*set willpower +1",
    "*if willpower > max_willpower",
    "\t*set willpower max_willpower",
    "*comment Restores some expended Сила воли",
    "",
    "*set hunger +1",
    "*if hunger > 5",
    "\t*set hunger 5",
    "\t*set health -1",
    "",
    "*set swordfight combat",
    "*set gunfight firearms",
    "*if has_better_sword",
    "\t*set swordfight +1",
    "*if has_better_gun",
    "\t*set gunfight +1",
    "*if sword_pearl",
    "\t*set swordfight +1",
    "*if gun_pearl",
    "\t*set gunfight +1",
    "",
    "*if missions = 0\t",
    "\t*set easy 1",
    "\t*set moderate 3",
    "\t*set hard 5",
    "\t*set very_hard 7",
    "\t*set damage 1",
    "*elseif missions = 1",
    "\t*set easy 2",
    "\t*set moderate 3",
    "\t*set hard 4",
    "\t*set very_hard 5",
    "\t*set damage 1",
    "*elseif missions = 2",
    "\t*set easy 3",
    "\t*set moderate 4",
    "\t*set hard 5",
    "\t*set very_hard 6",
    "\t*set damage 1",
    "*elseif missions = 3",
    "\t*set easy 3",
    "\t*set moderate 4",
    "\t*set hard 5",
    "\t*set very_hard 6",
    "\t*set damage 2",
    "*elseif missions = 4",
    "\t*set easy 4",
    "\t*set moderate 5",
    "\t*set hard 6",
    "\t*set very_hard 7",
    "\t*set damage 2",
    "*elseif missions = 5",
    "\t*set easy 5",
    "\t*set moderate 6",
    "\t*set hard 7",
    "\t*set very_hard 8",
    "\t*set damage 2",
    "*else\t",
    "\t*set easy 5",
    "\t*set moderate 6",
    "\t*set hard 7",
    "\t*set very_hard 8",
    "\t*set damage 3",
    "\t",
    "*set xp_penalty false",
    "\t\t",
    "*set tried_elena_alliance false",
    "*comment This one resets at the end of every mission so you can try to secure an alliance again",
    "",
    "*set ghoul_activity_available true",
    "*comment This variable means you have to complete a mission before you have another date/adventure/outing with your ghoul.",
    "",
    "*set garnet_ring_used false",
    "*set generation_7_used false",
    "*set generation_8_used false",
    "*set generation_9_used false",
    "*set generation_10_used false",
    "",
    "*set regained_willpower false",
    "*comment Lets you regain Сила воли after finishing a mission.",
    "",
    "*temp millicent_unlocks 0",
    "",
    "*if celerity_unlocked",
    "\t*set millicent_unlocks +1",
    "*if dominate_unlocked",
    "\t*set millicent_unlocks +1",
    "*if oblivion_unlocked",
    "\t*set millicent_unlocks +1",
    "*if potence_unlocked",
    "\t*set millicent_unlocks +1",
    "\t",
    "*if millicent_unlocks = 4",
    "\t*set millicent_blood_promised false",
    "*comment This causes you to lose your chance at Миллисент's Кровь if you've already unlocked all the Disciplines она can teach",
    "",
    "*return",
    ""
  ],
  "labels": {}
}