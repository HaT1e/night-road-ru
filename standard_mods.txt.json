{
  "crc": -2077108368,
  "lines": [
    "*label standard_mods",
    "*comment Resets blood use for round-by-round combat",
    "*set first_next \"Сначала\"",
    "*set focused false",
    "*comment Resets \"focused\" if you previously spent Сила воли",
    "*set hunger_penalty 0",
    "*if hunger > 5",
    "\t*set hunger 5",
    "*if ( hunger >= willpower ) and ( hunger > 0 )",
    "\t*set hunger_penalty -((hunger+1)-willpower)",
    "\t*label hunger_minimizer",
    "\t*if ( hunger_penalty +3 ) < 0",
    "\t\t*set hunger_penalty +1",
    "\t\t*goto hunger_minimizer",
    "\t*comment Голод: ${hunger}",
    "\t*comment Сила воли: ${willpower}",
    "\t*comment Голод Penalty: ${hunger_penalty}",
    "*comment Determines severity of hunger penalty",
    "*if clan = \"Бруха\"",
    "\t*set mess (4+hunger_penalty)",
    "\t*if mess < 0",
    "\t\t*set mess 0",
    "*else",
    "\t*set mess (5+hunger_penalty)",
    "\t*if mess < 1",
    "\t\t*set mess 1",
    "*comment Determines how easy it is to get a messy critical. Бруха trigger more messy criticals than other clans.",
    "*set human_penalty 0",
    "*if clan = \"Гангрел\"",
    "\t*if humanity = 3",
    "\t\t*set human_penalty -1",
    "\t*elseif humanity = 2",
    "\t\t*set human_penalty -2",
    "\t*elseif humanity = 1",
    "\t\t*set human_penalty -3",
    "\t*else",
    "\t\t*set human_penalty 0",
    "*else",
    "\t*if humanity = 2",
    "\t\t*set human_penalty -1",
    "\t*elseif humanity = 1",
    "\t\t*set human_penalty -2",
    "\t*else ",
    "\t\t*set human_penalty 0",
    "*comment Calculates penalty to human interaction based on Человечность. Гангрел suffer greater penalties.",
    "*set hunger_frenzy false",
    "*if ( willpower <= hunger ) and ( hunger > 3 )",
    "\t*set hunger_frenzy true",
    "*if health = max_health",
    "\t*set agg false",
    "*set obob \"[Затемнение]\"",
    "*if ( oblivion > (obfuscate+1) )",
    "\t*set obob \"[Забвение]\"",
    "*if ( obfuscate = 0 ) and ( oblivion > 0 )",
    "\t*set obob \"[Забвение]\"",
    "*set obpres \"[Присутствие]\"",
    "*if ( oblivion > (presence+1) )",
    "\t*set obpres \"[Забвение]\"",
    "*if ( presence = 0 ) and ( oblivion > 0 )",
    "\t*set obpres \"[Забвение]\"",
    "*return",
    ""
  ],
  "labels": {
    "standard_mods": 0,
    "hunger_minimizer": 10
  }
}